# Local development clients are not part of the production release artifact.
frontend/ export-ignore
mooncen-app/ export-ignore
tests/ export-ignore
tmp_*/ export-ignore
chromedriver/ export-ignore
.agents/ export-ignore
_organized/ export-ignore
*.dump export-ignore
*.key export-ignore
deploy.local.ps1 export-ignore
config/deploy_servers.json export-ignore
*.jks export-ignore
*.p8 export-ignore
*.mobileprovision export-ignore
*.sqlite export-ignore
*.db-wal export-ignore
*.db-shm export-ignore

# Versioned migration checksums must be identical on Windows and Linux.
DB/migrations/*.sql text eol=lf

# Source and deployment control files must not change checksums or parser
# behaviour between Windows authoring and Linux CI/production checkouts.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.ps1 text eol=lf
deploy/ubuntu/*.sh text eol=lf
deploy/ubuntu/systemd/* text eol=lf
deploy/ubuntu/nginx/*.conf text eol=lf
deploy/ha/*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
