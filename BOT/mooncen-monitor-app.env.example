# Copy to /etc/mooncen-monitor-app.env with root:root ownership and mode 0600.
# Keep every secret empty in source control and set it only on the monitor server.
MONITOR_APP_TOKEN=
MONITOR_APP_OPERATION_TOKEN=

# Dedicated server-to-server production quality endpoint. This token is not an
# Android setting and must never be embedded in an APK or download manifest.
# The upstream accepts only 32..256 URL-safe A-Z/a-z/0-9/_/- characters.
MOONCEN_SERVER_MONITOR_BASE_URL=https://mooncen.kr
MOONCEN_SERVER_MONITOR_TOKEN=
MOONCEN_SERVER_MONITOR_TIMEOUT_SECONDS=20
