# Non-secret settings loaded by the monitor API environment files.
MOONCEN_PUBLIC_BASE_URL=https://mooncen.kr
MONITOR_APP_PRIMARY_NODE=cloud
# Live evidence currently places the legacy timer and cycle metrics on cloud.
MONITOR_APP_CRAWLER_RUNTIME_NODE=cloud
# Reviewed worker placement after the controlled cutover; not queried as runtime yet.
MONITOR_APP_CRAWLER_TARGET_NODE=gen1crawler
# Shared staging DB and central crawler-control services are co-located here.
MONITOR_APP_CRAWLER_CONTROL_NODE=gen1db
MONITOR_APP_CRAWLER_MAX_AGE_SECONDS=129600
MONITOR_APP_FUNCTIONAL_TIMEOUT_SECONDS=5
MONITOR_APP_CORE_CACHE_TTL_SECONDS=30

# Shared by the Tailscale snapshot collector and monitor API.
MONITOR_APP_EXCLUDED_NODES=ds1515,ds718,n100
