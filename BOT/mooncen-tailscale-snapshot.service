[Unit]
Description=Collect a sanitized Tailscale status snapshot
Documentation=file:/usr/local/share/doc/mooncen-monitor/tailscale-snapshot.md
After=tailscaled.service
Wants=tailscaled.service

[Service]
Type=oneshot
User=root
Group=mooncen-monitor-snapshot
UMask=0027
EnvironmentFile=-/etc/mooncen-monitor-snapshot.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/mooncen-monitor/collect_tailscale_status.py --tailscale /usr/bin/tailscale --output /var/lib/mooncen-monitor/tailscale-status.json
TimeoutStartSec=30
StateDirectory=mooncen-monitor
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
