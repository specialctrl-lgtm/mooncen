Port 2222
AddressFamily inet
ListenAddress 100.75.187.63

HostKey /etc/ssh/ssh_host_ed25519_key
UsePAM yes
StrictModes yes
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
AllowUsers mooncen_container_deploy mooncen_container_status mooncen_ops_db_tunnel
AuthorizedKeysFile /etc/mooncen/ssh/authorized_keys/%u

AllowTcpForwarding no
AllowStreamLocalForwarding no
PermitOpen none
PermitListen none
GatewayPorts no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
PermitUserEnvironment no
PermitUserRC no

LoginGraceTime 30
MaxAuthTries 3
MaxSessions 1
ClientAliveInterval 60
ClientAliveCountMax 3
LogLevel VERBOSE

Match User mooncen_container_deploy
    ForceCommand /usr/local/libexec/mooncen-container-ssh-dispatch
    AllowTcpForwarding no
    PermitOpen none
    MaxSessions 1

Match User mooncen_container_status
    ForceCommand /usr/local/libexec/mooncen-container-ssh-dispatch
    AllowTcpForwarding no
    PermitOpen none
    MaxSessions 1

Match User mooncen_ops_db_tunnel
    ForceCommand /usr/bin/false
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:5432
    MaxSessions 0
