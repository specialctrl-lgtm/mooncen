Host cloud-container-deploy
    HostName 100.75.187.63
    Port 2222
    User mooncen_container_deploy
    IdentityFile /etc/mooncen-an2p/deploy-transport/id_ed25519
    IdentitiesOnly yes
    BatchMode yes
    ConnectTimeout 10
    StrictHostKeyChecking yes
    UpdateHostKeys no
    UserKnownHostsFile /etc/mooncen-an2p/deploy-transport/known_hosts
    GlobalKnownHostsFile /dev/null
    HostKeyAlgorithms ssh-ed25519
    PubkeyAcceptedAlgorithms ssh-ed25519
    PreferredAuthentications publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    NumberOfPasswordPrompts 0
    RequestTTY no
    ClearAllForwardings yes
    ForwardAgent no
    ForwardX11 no
    PermitLocalCommand no
    ProxyCommand none
    ProxyJump none
