# Copy this file to ~/.config/mooncen-docker/development.env. On POSIX hosts,
# keep the directory mode 0700 and this file mode 0600. Never store the active
# environment inside the repository or a Docker build context.

COMPOSE_PROJECT_NAME=mooncen-dev

MOONCEN_DB_NAME=mooncen
MOONCEN_DB_USER=mooncen_admin
MOONCEN_DB_PASSWORD=
MOONCEN_DB_API_USER=mooncen_api_login
MOONCEN_DB_API_PASSWORD=
MOONCEN_AUTH_SECRET=

MOONCEN_WEB_PORT=5174
MOONCEN_API_PORT=8001
# Optional image names are useful for a private registry or parallel projects.
MOONCEN_POSTGRES_IMAGE=mooncen/postgres:16-postgis-dev
# Persistent an2p Docker mode accepts only the exact tags from release.json.
# Keep the release directory under ~/.local/share/mooncen-docker/releases/<40hex-tree>
# with its release.json, images.tar, compose.production.yaml, and validation.json.
MOONCEN_DEV_RELEASE_DIR=
MOONCEN_API_IMAGE=mooncen/api:dev
MOONCEN_FRONTEND_IMAGE=mooncen/frontend:dev
MOONCEN_SITE_URL=http://localhost:5174
MOONCEN_CORS_ORIGINS=http://localhost:5174
MOONCEN_OAUTH_REDIRECT_URI=http://localhost:5174/
# Persistent/manual an2p use requires this absolute host path. Compose does not
# expand $HOME or ~ inside an env file.
# MOONCEN_RUNTIME_CONFIG_FILE=/home/sgm/.config/mooncen-docker/runtime-config.js

# These public browser values are rendered at container start/reload; they do
# not change the immutable frontend image.
# Never put the Kakao REST key, a DB password, or a server API token here.
MOONCEN_KAKAO_MAPS_JAVASCRIPT_KEY=
MOONCEN_GOOGLE_OAUTH_CLIENT_ID=
MOONCEN_NAVER_OAUTH_CLIENT_ID=

# Server-side OAuth secrets are optional for the first local start.
MOONCEN_GOOGLE_OAUTH_CLIENT_SECRET=
MOONCEN_NAVER_OAUTH_CLIENT_SECRET=
