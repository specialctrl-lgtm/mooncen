# Standalone MoonCen Ops Console origin.
#
# Install this on the Ops web host only. Do not merge its static root or
# catch-all route into the public mooncen.kr server block.
#
# If the API runs on another machine, replace 127.0.0.1:8001 with a private,
# authenticated upstream. Never expose that upstream directly to the Internet.

set_real_ip_from 127.0.0.1;
set_real_ip_from ::1;
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=mooncen_ops_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=mooncen_ops_auth:10m rate=5r/m;

server {
    # Designed for a local Cloudflare Tunnel or another authenticated edge.
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    server_name ops.mooncen.kr;

    root /opt/mooncen-ops-console/current;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests" always;

    location = /api/auth/ops/login {
        limit_req zone=mooncen_ops_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8001;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/auth/logout {
        limit_req zone=mooncen_ops_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8001;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/ops/ {
        limit_req zone=mooncen_ops_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8001;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
