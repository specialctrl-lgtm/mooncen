[Unit]
Description=MoonCen branch address and coordinate update
After=network.target postgresql.service

[Service]
Type=oneshot
SuccessExitStatus=3
User=mooncen-crawler
Group=mooncen-crawler
WorkingDirectory=/opt/mooncen
EnvironmentFile=/etc/mooncen/crawler.env
ExecStart=/bin/bash /opt/mooncen/deploy/ubuntu/mooncen_branch_coordinate_backfill.sh
RuntimeMaxSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/opt/mooncen/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
