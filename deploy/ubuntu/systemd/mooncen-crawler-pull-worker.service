[Unit]
Description=MoonCen centrally scheduled crawler pull worker
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/etc/mooncen/crawler-worker.env
ConditionPathExists=/opt/mooncen-crawler/current/release.env
ConditionPathExists=/opt/mooncen-worker/current/config/production_topology.json

[Service]
Type=simple
User=mooncen-crawler-worker
Group=mooncen-crawler-status
SupplementaryGroups=mooncen-crawler-worker mooncen
WorkingDirectory=/opt/mooncen-crawler/current
EnvironmentFile=/etc/mooncen/crawler-worker.env
EnvironmentFile=/opt/mooncen-crawler/current/release.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Seoul
Environment=HOME=/tmp
Environment=XDG_CACHE_HOME=/tmp/.cache
Environment=XDG_CONFIG_HOME=/tmp/.config
Environment=CRAWLER_LOG_DIR=/var/lib/mooncen-crawler-worker/logs
Environment=OPS_CRAWLER_TASK_RESULT_DIR=/run/mooncen-crawler/task-results
ExecStartPre=/usr/bin/mkdir -p /var/lib/mooncen-crawler-worker/logs /run/mooncen-crawler/task-results
ExecStartPre=/usr/bin/chmod 0700 /var/lib/mooncen-crawler-worker/logs /run/mooncen-crawler/task-results
ExecStartPre=/opt/mooncen-worker/current/.venv/bin/python -I -X utf8 /opt/mooncen-worker/current/tools/preflight_distributed_crawler_worker_host.py --inventory-only --worker-key ${OPS_CRAWLER_WORKER_ID} --kernel-hostname ${OPS_CRAWLER_WORKER_HOSTNAME} --require-enabled
ExecStartPre=/opt/mooncen-worker/current/.venv/bin/python -I -X utf8 /opt/mooncen-worker/current/tools/run_distributed_crawler_preflight.py --component worker --env-file /etc/mooncen/crawler-worker.env
ExecStart=/opt/mooncen-worker/current/.venv/bin/python -X utf8 -m ops_agent.crawler_worker
Restart=always
RestartSec=15s
TimeoutStopSec=33000s
KillMode=control-group
StateDirectory=mooncen-crawler-worker
StateDirectoryMode=0700
RuntimeDirectory=mooncen-crawler
RuntimeDirectoryMode=0750
UMask=0077
MemoryHigh=70%
MemoryMax=80%
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mooncen-crawler-worker /run/mooncen-crawler
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
