# Install as /etc/mooncen/crawler-control-finalizer.env, root:mooncen-crawler-finalizer 0640.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
# Login is converged to the narrow mooncen_crawler_finalizer group only.
OPS_CRAWLER_FINALIZER_DB_USER=mooncen_crawler_finalizer_login
OPS_CRAWLER_FINALIZER_DB_PASSWORD=replace_with_finalizer_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
OPS_CRAWLER_FINALIZER_POLL_SECONDS=10
# Canary/install default: sealing evidence is allowed, promotion is not.
OPS_CRAWLER_AUTO_PROMOTION_ENABLED=false
