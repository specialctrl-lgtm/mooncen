# Install as /etc/mooncen/crawler-control-scheduler.env, root:mooncen-crawler-control 0640.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
# Login is converged to the mooncen_crawler_control NOLOGIN group only.
OPS_CRAWLER_CONTROL_DB_USER=mooncen_crawler_control_login
OPS_CRAWLER_CONTROL_DB_PASSWORD=replace_with_control_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt

# This enables only the installed scheduler process.  The provisioning script
# still leaves its systemd unit disabled until the reviewed cutover command.
OPS_CRAWLER_CONTROL_ENABLED=true
OPS_CRAWLER_PROVIDER_MANIFEST=/opt/mooncen/config/production_crawler_providers.yaml
OPS_CRAWLER_CODE_VERSION=2026.08.10.1
OPS_CRAWLER_ARTIFACT_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Exact SHA-256 of OPS_CRAWLER_PROVIDER_MANIFEST.
OPS_CRAWLER_CONFIG_REVISION=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
OPS_CRAWLER_SCHEDULE_TIMEZONE=Asia/Seoul
OPS_CRAWLER_SCHEDULE_HOUR=22
OPS_CRAWLER_SCHEDULE_MINUTE=0
OPS_CRAWLER_SCHEDULE_MAX_LATE_SECONDS=21600
OPS_CRAWLER_CONTROL_POLL_SECONDS=30
OPS_CRAWLER_TASK_MAX_RETRIES=2
