# Install as /etc/mooncen/crawler-release-agent.env owned root:root mode 0600.
# The shipped safe default validates local policy only and performs no network
# request or release mutation.  Change to dry-run before a reviewed apply.
OPS_CRAWLER_RELEASE_MODE=check
OPS_CRAWLER_WORKER_ID=gen1crawler
OPS_CRAWLER_ENVIRONMENT=production

# Exact host allowlist.  Use Tailscale HTTPS names protected by tailnet ACLs;
# IP literals, credentials, query strings, fragments, and redirects are denied.
OPS_CRAWLER_ALLOWED_HTTPS_HOSTS=crawler-control.example-tailnet.ts.net,crawler-artifacts.example-tailnet.ts.net
OPS_CRAWLER_DESIRED_STATE_URL=https://crawler-control.example-tailnet.ts.net/state/desired-state.json
OPS_CRAWLER_ARTIFACT_BASE_URL=https://crawler-artifacts.example-tailnet.ts.net/crawler-artifacts/
OPS_CRAWLER_TLS_CA_FILE=/etc/mooncen/crawler-release-tls-ca.crt

OPS_CRAWLER_RELEASE_ROOT=/opt/mooncen-crawler
OPS_CRAWLER_RELEASE_STATE_DIR=/var/lib/mooncen-crawler-release-agent
OPS_CRAWLER_DRAIN_STATE=/run/mooncen-crawler/drain.json
OPS_CRAWLER_HEALTH_STATE=/run/mooncen-crawler/health.json
OPS_CRAWLER_HEALTH_TIMEOUT_SECONDS=90
OPS_CRAWLER_DRAIN_MAX_AGE_SECONDS=120
OPS_CRAWLER_MAX_UNPACKED_BYTES=2147483648
OPS_CRAWLER_MAX_ARCHIVE_FILES=30000

# Signatures are optional in the JSON schema but required by this production
# policy.  The file is an OpenSSH allowed-signers file, never a private key.
OPS_CRAWLER_REQUIRE_SIGNATURE=true
OPS_CRAWLER_ALLOWED_KEY_IDS=mooncen-crawler-release-2026
OPS_CRAWLER_ALLOWED_SIGNERS=/etc/mooncen/crawler-release-allowed-signers

# The agent writes these exact names into each verified release's release.env;
# operators must not set or override them in this policy file.
# OPS_CRAWLER_CODE_VERSION
# OPS_CRAWLER_ARTIFACT_DIGEST
# OPS_CRAWLER_CONFIG_REVISION
