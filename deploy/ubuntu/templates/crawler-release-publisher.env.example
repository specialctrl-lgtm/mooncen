# Install as /etc/mooncen/crawler-release-publisher.env, root:mooncen-crawler-publisher 0640.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
# Read-only publisher login; never reuse scheduler/control credentials.
OPS_CRAWLER_PUBLISHER_DB_USER=mooncen_crawler_publisher_login
OPS_CRAWLER_PUBLISHER_DB_PASSWORD=replace_with_publisher_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
OPS_CRAWLER_RELEASE_ENVIRONMENT=production
OPS_CRAWLER_DESIRED_STATE_OUTPUT=/var/lib/mooncen-crawler-control/public/state/desired-state.json
