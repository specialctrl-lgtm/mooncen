# Worker-host template. Install as /etc/mooncen/crawler-release-reporter.env,
# root:mooncen-crawler-reporter 0640. The reporter and worker logins are bound
# to the same agent but must use distinct credentials and OS accounts.
ENVIRONMENT=production
OPS_CRAWLER_WORKER_ID=worker-01
OPS_AGENT_ID=10000000-0000-0000-0000-000000000001
OPS_CRAWLER_WORKER_HOSTNAME=worker-01

OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
OPS_CRAWLER_REPORTER_DB_USER=mooncen_crawler_reporter_01_login
OPS_CRAWLER_REPORTER_DB_PASSWORD=replace_with_reporter_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
DB_CONNECT_TIMEOUT=5

OPS_CRAWLER_RELEASE_STATE_DIR=/var/lib/mooncen-crawler-release-agent
