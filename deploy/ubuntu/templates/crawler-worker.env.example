# Worker-host template. Install as /etc/mooncen/crawler-worker.env,
# root:mooncen-crawler-worker 0640. Queue and staging writes intentionally use
# the same login, which must be a member of mooncen_crawler_worker.
ENVIRONMENT=production
OPS_CRAWLER_WORKER_ID=worker-01
OPS_AGENT_ID=10000000-0000-0000-0000-000000000001
OPS_CRAWLER_WORKER_HOSTNAME=worker-01

OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
OPS_QUEUE_DB_HOST=gen1db
OPS_QUEUE_DB_PORT=5432
OPS_QUEUE_DB_NAME=mooncen_staging
OPS_QUEUE_DB_USER=mooncen_crawler_worker_01_login
OPS_QUEUE_DB_PASSWORD=replace_with_worker_login_password
CRAWL_WRITE_MODE=staging
CRAWL_STAGING_DB_HOST=gen1db
CRAWL_STAGING_DB_PORT=5432
CRAWL_STAGING_DB_NAME=mooncen_staging
CRAWL_STAGING_DB_USER=mooncen_crawler_worker_01_login
CRAWL_STAGING_DB_PASSWORD=replace_with_worker_login_password
DB_CRAWLER_USER=mooncen_crawler_worker_01_login
DB_CRAWLER_PASSWORD=replace_with_worker_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt

OPS_JOB_POLL_INTERVAL_SECONDS=2
OPS_CRAWLER_JOB_TIMEOUT_SECONDS=32400
OPS_CRAWLER_LEASE_SECONDS=60
OPS_CRAWLER_HEALTH_STATE=/run/mooncen-crawler/health.json
OPS_CRAWLER_DRAIN_STATE=/run/mooncen-crawler/drain.json

# Add provider API/browser configuration required by this deployment.  Release
# identity variables are supplied only by current/release.env.
