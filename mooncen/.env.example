# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mooncen
# Schema migration owner; do not expose this credential to runtime services.
DB_USER=mooncen_admin
DB_PASSWORD=your_secure_password_here
DB_API_USER=mooncen_api_login
DB_API_PASSWORD=replace-with-a-distinct-long-random-password
DB_CRAWLER_USER=mooncen_crawler_login
DB_CRAWLER_PASSWORD=replace-with-a-distinct-long-random-password
DB_AI_USER=mooncen_ai_login
DB_AI_PASSWORD=replace-with-a-distinct-long-random-password
PRIMARY_DB_USER=mooncen_applier_login
PRIMARY_DB_PASSWORD=replace-with-a-distinct-long-random-password
DB_BACKUP_USER=mooncen_backup_login
DB_BACKUP_PASSWORD=replace-with-a-distinct-long-random-password
DB_CHECK_USER=mooncen_check_login
DB_CHECK_PASSWORD=replace-with-a-distinct-long-random-password
# A worker EnvironmentFile maps its dedicated login to these generic runtime keys.
DB_RUNTIME_USER=
DB_RUNTIME_PASSWORD=
DB_APPLICATION_NAME=mooncen-local-worker
DB_POOL_MIN=1
DB_POOL_MAX=8
# Remote production databases default to verify-full when DB_SSLMODE is unset.
DB_SSLMODE=
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=http://localhost:5174/
OAUTH_ALLOW_LEGACY_STATE=false
# Admin email entries are honored only when the OAuth provider verified them.
MOONCEN_ADMIN_EMAILS=
# Immutable provider identities, for example: google:123456789,naver:provider-user-id
MOONCEN_ADMIN_PROVIDER_IDS=
# Bug reports are delivered by the API only. Keep SMTP credentials out of every
# VITE_* variable and frontend environment file.
MOONCEN_BUG_REPORT_TO=
MOONCEN_BUG_REPORT_FROM=
MOONCEN_SMTP_HOST=
MOONCEN_SMTP_PORT=587
MOONCEN_SMTP_USERNAME=
MOONCEN_SMTP_PASSWORD=
# starttls (recommended), ssl, or none (development/internal testing only)
MOONCEN_SMTP_SECURITY=starttls
# Optional server-side Cloudflare zone analytics for the Ops Console. The
# token needs Account Analytics Read, resource-scoped to the MoonCen zone, and
# must never use VITE_*.
OPS_CLOUDFLARE_ANALYTICS_ZONE_ID=
OPS_CLOUDFLARE_ANALYTICS_TOKEN=
# Standalone console login. Store only a PBKDF2-HMAC-SHA256 encoded hash.
MOONCEN_OPS_SINGLE_ACCOUNT_ONLY=true
MOONCEN_OPS_LOGIN_ID=opsadmin
MOONCEN_OPS_PASSWORD_HASH=
OPENAI_API_KEY=your_openai_api_key_here
CULTURE_API_SERVICE_KEY=your_data_go_kr_culture_api_service_key_here

# AI / Ollama Settings
OLLAMA_HOST=http://wtr-linux:11434
OLLAMA_HOSTS=http://wtr-linux:11434,http://victus:11434
OLLAMA_MODEL=qwen3.5:9b
AI_WORKERS=2
AI_PROVIDER=OLLAMA

# Crawler Settings
# Server-only Kakao Local API credential. Never use a VITE_ prefix for this key.
KAKAO_MAPS_REST_API_KEY=
KAKAO_GEOCODE_MAX_REQUESTS_PER_RUN=1000
CRAWLER_PROVIDERS="HOMEPLUS EMART LOTTE SEOSAN_WELFARE_TOTAL_RESERVATION EXPERIENCE_TARGETS MUNICIPAL_RESERVATION_TARGETS"
CRAWLER_DELAY=1
CRAWLER_TIMEOUT=10
# HOMEPLUS notice monitoring: newest feed rows and publication lookback window.
HOMEPLUS_NOTICE_LIMIT=200
HOMEPLUS_NOTICE_LOOKBACK_DAYS=210
LOTTE_NOTICE_LIMIT=200
LOTTE_NOTICE_LOOKBACK_DAYS=210
EMART_GRAPHQL_API_KEY=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Log Settings
LOG_LEVEL=INFO
LOG_FILE=logs/mooncen.log

# App Settings
ENVIRONMENT=development
AUTH_SECRET=replace-with-at-least-32-random-bytes
MOONCEN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MOONCEN_TRUSTED_HOSTS=localhost,127.0.0.1,mooncen.kr,ops.mooncen.kr
VITE_SITE_URL=https://mooncen.kr
VITE_OAUTH_REDIRECT_URI=https://mooncen.kr/
# The standalone Ops host uses a same-origin /api reverse proxy and dedicated
# password login. It needs a trusted Host entry, not CORS or OAuth access.
OAUTH_REDIRECT_URIS=https://mooncen.kr/

# Backup encryption (age public recipient; keep the private identity outside this repository)
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/etc/mooncen/backup-age-key.txt
BACKUP_IDENTITY_FILE=/etc/mooncen/backup-ssh-key
BACKUP_KNOWN_HOSTS_FILE=/etc/mooncen/backup-known-hosts
BACKUP_MANIFEST_SIGNING_KEY=/etc/mooncen/backup-manifest-signing-key
BACKUP_MANIFEST_ALLOWED_SIGNERS=/etc/mooncen/backup-manifest-allowed-signers
BACKUP_PORT=
BACKUP_RETENTION_DAYS=35
# Restore accepts only signed, encrypted, timestamped custom-format dumps.
BACKUP_MAX_ENCRYPTED_DUMP_BYTES=68719476736
BACKUP_MAX_DECRYPTED_DUMP_BYTES=68719476736
BACKUP_LOCAL_MIN_FREE_BYTES=1073741824
BACKUP_DB_MIN_FREE_BYTES=2147483648
BACKUP_RESTORE_EXPANSION_FACTOR=4
BACKUP_MAX_AGE_SECONDS=604800
BACKUP_MAX_APP_ARCHIVE_BYTES=2147483648
BACKUP_MAX_CONFIG_ARCHIVE_BYTES=268435456
BACKUP_MAX_SOURCE_DB_BYTES=274877906944
# Manual production disaster recovery only; never set this persistently for the scheduled restore test.
ALLOW_STALE_SIGNED_BACKUP=0
RESTORE_MIN_COURSES=1
RESTORE_MIN_BRANCHES=1

# Standalone Ops Console
MOONCEN_GRAFANA_URL=
# One shared staging PostgreSQL holds the queue, fenced crawl snapshots,
# release desired state, and batch finalizer evidence.
OPS_CRAWLER_SHARED_DB_HOST=
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging

# Optional, isolated Ops API connection to the crawler-control database.
# There is deliberately no fallback to the primary DB_API_* credential.
OPS_CRAWLER_API_DB_USER=mooncen_crawler_api_login
OPS_CRAWLER_API_DB_PASSWORD=
OPS_CRAWLER_API_DB_REQUIRED=false
OPS_CRAWLER_API_DB_POOL_SIZE=2
OPS_CRAWLER_API_DB_POOL_TIMEOUT=5
OPS_CRAWLER_API_DB_POOL_RECYCLE=1800

# Restricted worker role on that shared database.
OPS_QUEUE_DB_HOST=
OPS_QUEUE_DB_PORT=5432
OPS_QUEUE_DB_NAME=mooncen_staging
OPS_QUEUE_DB_USER=mooncen_crawler_worker_login
OPS_QUEUE_DB_PASSWORD=

# Central scheduler role on the same shared database.
OPS_CRAWLER_CONTROL_DB_USER=mooncen_crawler_control_login
OPS_CRAWLER_CONTROL_DB_PASSWORD=
# Read-only desired-state publisher role.
OPS_CRAWLER_PUBLISHER_DB_USER=mooncen_crawler_publisher_login
OPS_CRAWLER_PUBLISHER_DB_PASSWORD=

# Batch finalizer reads immutable staging snapshots and seals held crawl_batches.
OPS_CRAWLER_FINALIZER_DB_USER=mooncen_crawler_finalizer_login
OPS_CRAWLER_FINALIZER_DB_PASSWORD=
# Root-only human approval command; never load this credential into a daemon.
OPS_CRAWLER_APPROVER_DB_USER=mooncen_crawler_approver_login
OPS_CRAWLER_APPROVER_DB_PASSWORD=
# Independent rollout approver; root-only command credential, never used by API/daemon.
OPS_CRAWLER_RELEASE_APPROVER_DB_USER=mooncen_crawler_release_approver_login
OPS_CRAWLER_RELEASE_APPROVER_DB_PASSWORD=
# Privileged rollout consumer; distinct from the approver and the Ops API.
OPS_CRAWLER_RELEASE_ADMIN_DB_USER=mooncen_crawler_release_admin_login
OPS_CRAWLER_RELEASE_ADMIN_DB_PASSWORD=
# Each remote host uses distinct worker and reporter logins bound to one agent.
OPS_CRAWLER_REPORTER_DB_USER=mooncen_crawler_reporter_login
OPS_CRAWLER_REPORTER_DB_PASSWORD=
# Bounded, column-only central metrics reader.
OPS_CRAWLER_METRICS_DB_USER=mooncen_crawler_observer_login
OPS_CRAWLER_METRICS_DB_PASSWORD=
OPS_AGENT_ID=
OPS_JOB_POLL_INTERVAL_SECONDS=2
OPS_CRAWLER_JOB_TIMEOUT_SECONDS=32400
# The local Ops launcher queues these providers through the same audited worker
# used by manual crawler runs. Empty falls back to CRAWLER_PROVIDERS, then to
# HOMEPLUS/EMART/LOTTE/EXPERIENCE_TARGETS/MUNICIPAL_RESERVATION_TARGETS.
OPS_LOCAL_CRAWLER_PROVIDERS=
OPS_LOCAL_CRAWLER_INTERVAL_SECONDS=86400
OPS_LOCAL_CRAWLER_SCHEDULER_POLL_SECONDS=30
OPS_LOCAL_CRAWLER_RUNTIME_ENABLED=false
# Local/development status publisher. Override URLs when services use other ports.
OPS_STATUS_INTERVAL_SECONDS=30
OPS_STATUS_BACKEND_URL=http://127.0.0.1:8001/health
OPS_STATUS_FRONTEND_URL=http://127.0.0.1:5174/
OPS_STATUS_CONSOLE_URL=http://127.0.0.1:5175/
OPS_STATUS_OLLAMA_URL=http://127.0.0.1:11434/api/tags
# Quality worker uses the read-only/check role plus narrowly granted Ops writes.
OPS_QUALITY_QUEUE_DB_HOST=
OPS_QUALITY_QUEUE_DB_PORT=5432
OPS_QUALITY_QUEUE_DB_NAME=mooncen
OPS_QUALITY_QUEUE_DB_USER=mooncen_check_login
OPS_QUALITY_QUEUE_DB_PASSWORD=
OPS_QUALITY_AGENT_ID=
OPS_QUALITY_JOB_POLL_INTERVAL_SECONDS=3
OPS_QUALITY_STATEMENT_TIMEOUT_MS=900000
# Restricted deployment worker. Production must use a login that is a member
# only of the NOLOGIN mooncen_deployment_worker role; crawler credentials may
# not append Docker evidence or execute the deployment queue.
OPS_DEPLOY_QUEUE_DB_HOST=
OPS_DEPLOY_QUEUE_DB_PORT=5432
OPS_DEPLOY_QUEUE_DB_NAME=mooncen
OPS_DEPLOY_QUEUE_DB_USER=mooncen_deployment_worker_login
OPS_DEPLOY_QUEUE_DB_PASSWORD=
OPS_DEPLOY_POLL_INTERVAL_SECONDS=2
OPS_DEPLOY_JOB_TIMEOUT_SECONDS=7200
OPS_DEPLOY_STALE_HEARTBEAT_SECONDS=300
# Canonical smoke._development_target_identity() SHA-256 and the private
# fixed-root release store. Browser/API requests never supply this path.
OPS_CONTAINER_DEV_TARGET_IDENTITY=
OPS_CONTAINER_RELEASE_ROOT=/home/sgm/.local/share/mooncen-docker/releases
# Dedicated URL-safe machine token for the narrow read-only BOT monitor
# endpoint. Do not reuse an APK token, Ops password, or browser session token.
MOONCEN_SERVER_MONITOR_TOKEN=
MOONCEN_SERVER_MONITOR_STALE_AFTER=120
MOONCEN_SERVER_MONITOR_CPU_WARN=90
MOONCEN_SERVER_MONITOR_MEMORY_WARN=90
MOONCEN_SERVER_MONITOR_DISK_WARN=95
