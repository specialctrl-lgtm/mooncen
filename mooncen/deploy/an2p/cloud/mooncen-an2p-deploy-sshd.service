[Unit]
Description=MoonCen an2p-only deployment OpenSSH endpoint
Documentation=man:sshd(8) man:sshd_config(5)
After=network-online.target tailscaled.service ssh.service
Wants=network-online.target tailscaled.service ssh.service

[Service]
Type=notify
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/mooncen-an2p-deploy-sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/mooncen-an2p-deploy-sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
