[Unit]
Description=MoonCen privileged crawler release action consumer
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/mooncen/crawler-release-admin.env
ConditionPathIsDirectory=/var/lib/mooncen-crawler-control/public/artifacts

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/mooncen
EnvironmentFile=/etc/mooncen/crawler-release-admin.env
ExecStartPre=/opt/mooncen/.venv/bin/python -X utf8 -m tools.preflight_distributed_crawler_control --component release_admin --env-file /etc/mooncen/crawler-release-admin.env
ExecStartPre=/opt/mooncen/.venv/bin/python -X utf8 -m ops_agent.crawler_release_action_worker --check
ExecStart=/opt/mooncen/.venv/bin/python -X utf8 -m ops_agent.crawler_release_action_worker
Restart=on-failure
RestartSec=15s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/mooncen-crawler-control/public

[Install]
WantedBy=multi-user.target
