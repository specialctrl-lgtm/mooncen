# Install as /etc/mooncen/crawler-control-metrics.env, root:mooncen-crawler-observer 0640.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging

# This must be a LOGIN that inherits only mooncen_crawler_observer.  Do not
# reuse scheduler, finalizer, worker, API, or general readonly credentials.
OPS_CRAWLER_METRICS_DB_USER=mooncen_crawler_observer_login
OPS_CRAWLER_METRICS_DB_PASSWORD=replace_with_observer_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
DB_CONNECT_TIMEOUT=5

OPS_CRAWLER_METRICS_OUTPUT=/var/lib/mooncen-crawler-observer/mooncen_crawler_control.prom
OPS_CRAWLER_METRICS_STATEMENT_TIMEOUT_MS=5000
OPS_CRAWLER_METRICS_LOCK_TIMEOUT_MS=1000
