# One-time schema administrator input for setup_distributed_crawler_control.sh.
# Copy to a root-owned 0600 file outside the repository.  It is never installed
# as a systemd EnvironmentFile.
OPS_CRAWLER_SCHEMA_DB_HOST=gen1db
OPS_CRAWLER_SCHEMA_DB_PORT=5432
OPS_CRAWLER_SCHEMA_DB_NAME=mooncen_staging
OPS_CRAWLER_SCHEMA_DB_USER=mooncen_crawler_schema_admin
OPS_CRAWLER_SCHEMA_DB_PASSWORD=replace_with_schema_admin_password
# Every non-extension object in public/crawl_staging must have this owner.
OPS_CRAWLER_SCHEMA_OBJECT_OWNER=mooncen_staging_owner
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
