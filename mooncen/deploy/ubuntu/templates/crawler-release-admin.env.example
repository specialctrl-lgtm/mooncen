# Install as /etc/mooncen/crawler-release-admin.env, root:root 0600. The
# privileged release-action consumer and reviewed operator commands load it;
# the Ops API and crawler workers must never receive this credential.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
OPS_CRAWLER_RELEASE_ADMIN_DB_USER=mooncen_crawler_release_admin_login
OPS_CRAWLER_RELEASE_ADMIN_DB_PASSWORD=replace_with_release_admin_login_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
DB_CONNECT_TIMEOUT=5
OPS_CRAWLER_RELEASE_PUBLIC_ROOT=/var/lib/mooncen-crawler-control/public
OPS_CRAWLER_ALLOWED_SIGNERS=/etc/mooncen/crawler-release-allowed-signers
# Must remain within 30..900; 360 covers the independent 2m agent/reporter timers and jitter.
OPS_CRAWLER_RELEASE_BASELINE_FRESH_SECONDS=360
OPS_LOG_LEVEL=INFO
