# Install as /etc/mooncen/crawler-release-approver.env, root:root 0600.
# This independent credential can preview/approve rollout requests only. It is
# never loaded by the Ops API, release consumer, crawler worker, or a daemon.
ENVIRONMENT=production
OPS_CRAWLER_SHARED_DB_HOST=gen1db
OPS_CRAWLER_SHARED_DB_PORT=5432
OPS_CRAWLER_SHARED_DB_NAME=mooncen_staging
OPS_CRAWLER_RELEASE_APPROVER_DB_USER=mooncen_crawler_release_approver_login
OPS_CRAWLER_RELEASE_APPROVER_DB_PASSWORD=replace_with_unique_release_approver_password
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mooncen/db-root-ca.crt
DB_CONNECT_TIMEOUT=5
