{
  "name": "mooncen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --environment jsdom",
    "test:e2e": "playwright test",
    "audit:css": "node tools/css-audit.mjs",
    "maintain:css": "node tools/prune-css.mjs && node tools/split-css.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "serve -s dist -n --no-port-switching"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "purgecss": "^8.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
